{% doc %}
  @prompt
    Elevated luxury recently added products section for Beg Borrow Steal Studio
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-recent-products-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-recent-products-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-recent-products-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
  }

  .ai-recent-products-heading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 500;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .ai-recent-products-subtitle-{{ ai_gen_id }} {
    margin: 6px 0 0;
    font-size: 13px;
    color: #888888;
    letter-spacing: 0.3px;
  }

  .ai-recent-products-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-recent-product-card-{{ ai_gen_id }} {
    position: relative;
    display: flex !important;
    flex-direction: column !important;
    text-decoration: none !important;
    color: inherit !important;
    background: #ffffff;
    border: 1px solid #f0f0f0;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    height: 100%;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease;
  }

  .ai-recent-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    border-color: #e2ded8;
  }

  .ai-recent-product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: {{ block.settings.image_background_color | default: '#ffffff' }};
    display: block;
  }

  .ai-recent-product-image-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain !important;
    padding: 16px;
    box-sizing: border-box;
    background-color: transparent;
    transition: opacity 0.3s ease;
  }

  .ai-recent-product-image-{{ ai_gen_id }}.is-primary {
    opacity: 1;
    z-index: 1;
  }

  .ai-recent-product-image-{{ ai_gen_id }}.is-hover {
    opacity: 0;
    z-index: 2;
  }

  @media (min-width: 1025px) and (hover: hover) {
    .ai-recent-product-card-{{ ai_gen_id }}:hover .ai-recent-product-image-{{ ai_gen_id }}.is-primary {
      opacity: 0;
    }
    .ai-recent-product-card-{{ ai_gen_id }}:hover .ai-recent-product-image-{{ ai_gen_id }}.is-hover {
      opacity: 1;
    }
  }

  .ai-recent-product-badges-{{ ai_gen_id }} {
    position: absolute;
    top: 8px;
    left: 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    z-index: 3;
    pointer-events: none;
  }

  .ai-recent-badge-{{ ai_gen_id }} {
    display: inline-block;
    padding: 2px 7px;
    border-radius: 3px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    line-height: 1.5;
  }

  .ai-recent-badge-sale-{{ ai_gen_id }} {
    background: #e8000d;
    color: #ffffff;
  }

  .ai-recent-badge-condition-{{ ai_gen_id }} {
    background: rgba(255, 255, 255, 0.94);
    color: #333333;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .ai-recent-badge-sold-{{ ai_gen_id }} {
    background: #1a1a1a;
    color: #ffffff;
  }

  .ai-recent-product-placeholder-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f8f8f8;
  }

  .ai-recent-product-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-recent-product-body-{{ ai_gen_id }} {
    padding: 12px 14px 16px;
    display: flex !important;
    flex-direction: column !important;
    flex-grow: 1;
    text-align: left;
  }

  .ai-recent-product-vendor-{{ ai_gen_id }} {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #999999;
    margin-bottom: 4px;
    text-align: left;
  }

  .ai-recent-product-title-{{ ai_gen_id }} {
    margin: 0 0 8px;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    font-weight: {{ block.settings.title_font_weight }};
    line-height: 1.4;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    min-height: 36px;
    text-align: left;
    transition: color 0.2s ease;
  }

  .ai-recent-product-card-{{ ai_gen_id }}:hover .ai-recent-product-title-{{ ai_gen_id }} {
    color: #472B03;
  }

  .ai-recent-product-price-wrap-{{ ai_gen_id }} {
    display: flex !important;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    flex-wrap: wrap;
    text-align: left;
  }

  .ai-recent-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: {{ block.settings.price_font_weight }};
    text-align: left;
  }

  .ai-recent-price-sale-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    font-weight: 700;
    color: #e8000d;
    text-align: left;
  }

  .ai-recent-price-compare-{{ ai_gen_id }} {
    font-size: 12px;
    color: #bbbbbb;
    text-decoration: line-through;
    text-align: left;
  }

  @media screen and (max-width: 989px) {
    .ai-recent-products-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-recent-products-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: 10px;
    }

    .ai-recent-products-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.75);
    }

    .ai-recent-product-image-{{ ai_gen_id }} {
      padding: 10px;
    }

    .ai-recent-product-body-{{ ai_gen_id }} {
      padding: 8px 10px 12px;
    }

    .ai-recent-product-title-{{ ai_gen_id }} {
      font-size: 12px;
      min-height: 32px;
      margin-bottom: 6px;
    }

    .ai-recent-product-price-{{ ai_gen_id }},
    .ai-recent-price-sale-{{ ai_gen_id }} {
      font-size: 13px;
    }
  }
{% endstyle %}

<recent-products-{{ ai_gen_id }} class="ai-recent-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-recent-products-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-recent-products-header-{{ ai_gen_id }}">
        <h2 class="ai-recent-products-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        <p class="ai-recent-products-subtitle-{{ ai_gen_id }}">Explore the newest arrivals in our curated vintage archive</p>
      </div>
    {% endif %}

    <div class="ai-recent-products-grid-{{ ai_gen_id }}">
      {%- assign current_prod_id = product.id -%}
      {%- assign recent_products = collections.all.products | sort: 'created_at' | reverse -%}
      {%- assign shown_count = 0 -%}

      {%- for p in recent_products -%}
        {%- if p.id == current_prod_id -%}{%- continue -%}{%- endif -%}
        {%- if shown_count >= block.settings.products_to_show -%}{%- break -%}{%- endif -%}
        {%- assign shown_count = shown_count | plus: 1 -%}

        {%- assign on_sale = false -%}
        {%- if p.compare_at_price > p.price -%}{%- assign on_sale = true -%}{%- endif -%}
        {%- assign pct = 0 -%}
        {%- if on_sale -%}
          {%- assign pct = p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price | round -%}
        {%- endif -%}

        {%- assign condition_tag = '' -%}
        {%- for tag in p.tags -%}
          {%- if tag == 'New' or tag == 'Excellent' or tag == 'Very Good' or tag == 'Good' or tag == 'Fair' -%}
            {%- assign condition_tag = tag -%}
          {%- endif -%}
        {%- endfor -%}

        {%- assign p_images = p.media | default: p.images -%}

        <a href="{{ p.url }}" class="ai-recent-product-card-{{ ai_gen_id }}">
          <div class="ai-recent-product-image-wrapper-{{ ai_gen_id }}">
            <div class="ai-recent-product-badges-{{ ai_gen_id }}">
              {%- unless p.available -%}
                <span class="ai-recent-badge-{{ ai_gen_id }} ai-recent-badge-sold-{{ ai_gen_id }}">Sold</span>
              {%- endunless -%}
              {%- if on_sale -%}
                <span class="ai-recent-badge-{{ ai_gen_id }} ai-recent-badge-sale-{{ ai_gen_id }}">-{{ pct }}%</span>
              {%- endif -%}
              {%- if condition_tag != '' -%}
                <span class="ai-recent-badge-{{ ai_gen_id }} ai-recent-badge-condition-{{ ai_gen_id }}">{{ condition_tag }}</span>
              {%- endif -%}
            </div>

            {%- if p_images.size > 0 -%}
              <img
                src="{{ p_images[0] | image_url: width: 800 }}"
                alt="{{ p.title | escape }}"
                width="800"
                height="800"
                loading="lazy"
                class="ai-recent-product-image-{{ ai_gen_id }} is-primary"
              >
              {%- if p_images.size > 1 -%}
                <img
                  src="{{ p_images[1] | image_url: width: 800 }}"
                  alt="{{ p.title | escape }}"
                  width="800"
                  height="800"
                  loading="lazy"
                  class="ai-recent-product-image-{{ ai_gen_id }} is-hover"
                >
              {%- endif -%}
            {%- elsif p.featured_image -%}
              <img
                src="{{ p.featured_image | image_url: width: 800 }}"
                alt="{{ p.title | escape }}"
                width="800"
                height="800"
                loading="lazy"
                class="ai-recent-product-image-{{ ai_gen_id }} is-primary"
              >
            {%- else -%}
              <div class="ai-recent-product-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {%- endif -%}
          </div>

          <div class="ai-recent-product-body-{{ ai_gen_id }}">
            {%- if p.vendor != blank -%}
              <div class="ai-recent-product-vendor-{{ ai_gen_id }}">{{ p.vendor }}</div>
            {%- endif -%}

            <h3 class="ai-recent-product-title-{{ ai_gen_id }}">{{ p.title }}</h3>

            <div class="ai-recent-product-price-wrap-{{ ai_gen_id }}">
              {%- if on_sale -%}
                <span class="ai-recent-price-sale-{{ ai_gen_id }}">{% render 'indian-price', price: p.price %}</span>
                <span class="ai-recent-price-compare-{{ ai_gen_id }}">{% render 'indian-price', price: p.compare_at_price %}</span>
              {%- else -%}
                <span class="ai-recent-product-price-{{ ai_gen_id }}">{% render 'indian-price', price: p.price %}</span>
              {%- endif -%}
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</recent-products-{{ ai_gen_id }}>

<script>
  (function() {
    class RecentProducts{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
      connectedCallback() {}
    }
    customElements.define('recent-products-{{ ai_gen_id }}', RecentProducts{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Recent products",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
