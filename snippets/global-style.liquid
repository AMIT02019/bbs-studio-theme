.site-nav a, .site-nav span, .menu-drawer a, .menu-drawer span,
.header__menu-item, .header__icon, .halo-sidebar-menu a,
.cpg-filter-title, .cpg-filter-option, .cpg-filter-group button,
.footer, .footer p, .footer a, .footer li, .footer span,
