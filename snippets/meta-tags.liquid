{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: shop.url
  assign og_type = 'website'
  
  if page_description != blank
    assign og_description = page_description | strip_html | escape
  elsif template contains 'collection' and collection.description != blank
    assign og_description = collection.description | strip_html | truncate: 155 | escape
  elsif template contains 'product' and product.description != blank
    assign og_description = product.description | strip_html | truncate: 155 | escape
  elsif page.handle == 'vintage-designer-jewellery'
    assign og_description = "Explore authentic vintage designer jewellery at Beg Borrow Steal Studio. Curated Chanel, Dior, Yves Saint Laurent necklaces, earrings, brooches, and cuffs in Mumbai." | escape
  elsif page.handle == 'about-us'
    assign og_description = "Learn about Beg Borrow Steal Studio in Mumbai, founded by Pranav Sood and Krisna Krishnankutty. Discover our story of authentic archival vintage fashion and jewellery." | escape
  else
    assign og_description = "Step into our sanctuary of vintage fashion, statement accessories, rare antiques, and exquisite fine art. Embrace mindful luxury through our one-of-a-kind curated finds." | escape
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'collection'
    assign og_type = 'product.group'
  elsif request.page_type == 'password'
    assign og_url = shop.url
  endif
-%}

<meta property="og:site_name" content="{{ shop.name | default: 'Beg Borrow Steal Studio' }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description }}">
<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' | default: 'en_US' }}">

{%- liquid
  assign og_img_url = ''
  assign og_img_w = 1200
  assign og_img_h = 630

  if request.page_type == 'product' and product.featured_image
    assign og_img_url = product.featured_image | img_url: 'master'
    assign og_img_w = product.featured_image.width
    assign og_img_h = product.featured_image.height
  elsif request.page_type == 'article' and article.image
    assign og_img_url = article.image | img_url: 'master'
    assign og_img_w = article.image.width
    assign og_img_h = article.image.height
  elsif request.page_type == 'collection' and collection.image
    assign og_img_url = collection.image | img_url: 'master'
    assign og_img_w = collection.image.width
    assign og_img_h = collection.image.height
  else
    assign og_img_url = 'bbs_social_share.png' | asset_url
  endif
-%}

{%- if og_img_url != blank -%}
  <meta property="og:image" content="https:{{ og_img_url }}">
  <meta property="og:image:secure_url" content="https:{{ og_img_url }}">
  <meta property="og:image:width" content="{{ og_img_w }}">
  <meta property="og:image:height" content="{{ og_img_h }}">
  <meta property="og:image:alt" content="{{ og_title | escape }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html | remove: ',' }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | strip_html | remove: ',' }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
  <meta property="product:condition" content="used">
  {%- if product.vendor != blank -%}
    <meta property="product:brand" content="{{ product.vendor | escape }}">
  {%- endif -%}
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description }}">
{%- if og_img_url != blank -%}
  <meta name="twitter:image" content="https:{{ og_img_url }}">
  <meta name="twitter:image:alt" content="{{ og_title | escape }}">
{%- endif -%}
