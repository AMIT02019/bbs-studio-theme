<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 540 600" width="100%" height="100%">
  <defs>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@500;800;900&amp;display=swap');
      
      .bbs-solid-part {
        fill: #573400;
      }
      .bbs-dotted-part {
        fill: none;
        stroke: #573400;
        stroke-width: 3.2;
        stroke-dasharray: 4.5, 4.5;
        stroke-linecap: round;
      }
      .bbs-text-line1 {
        font-family: 'Montserrat', 'Century Gothic', 'Futura', -apple-system, sans-serif;
        font-weight: 800;
        font-size: 27px;
        fill: #573400;
        letter-spacing: 0.28em;
        text-anchor: middle;
      }
      .bbs-text-line2 {
        font-family: 'Montserrat', 'Century Gothic', 'Futura', -apple-system, sans-serif;
        font-weight: 500;
        font-size: 58px;
        fill: #573400;
        letter-spacing: 0.55em;
        text-anchor: middle;
      }
    </style>
  </defs>

  <!-- 3 BBB SHAPES -->
  <g transform="translate(45, 25)">
    <!-- COLUMN 1: Center X = 75 -->
    <!-- Top circle: CX=75, CY=75, R=72 -->
    <path class="bbs-dotted-part" d="M 75,3 A 72,72 0 0,0 75,147" />
    <path class="bbs-solid-part" d="M 75,3 A 72,72 0 0,1 75,147 Z" />
    <!-- Bottom circle: CX=75, CY=219, R=72 -->
    <path class="bbs-dotted-part" d="M 75,147 A 72,72 0 0,0 75,291" />
    <path class="bbs-solid-part" d="M 75,147 A 72,72 0 0,1 75,291 Z" />

    <!-- COLUMN 2: Center X = 225 -->
    <!-- Top circle: CX=225, CY=75, R=72 -->
    <path class="bbs-dotted-part" d="M 225,3 A 72,72 0 0,0 225,147" />
    <path class="bbs-solid-part" d="M 225,3 A 72,72 0 0,1 225,147 Z" />
    <!-- Bottom circle: CX=225, CY=219, R=72 -->
    <path class="bbs-dotted-part" d="M 225,147 A 72,72 0 0,0 225,291" />
    <path class="bbs-solid-part" d="M 225,147 A 72,72 0 0,1 225,291 Z" />

    <!-- COLUMN 3: Center X = 375 -->
    <!-- Top circle: CX=375, CY=75, R=72 -->
    <path class="bbs-dotted-part" d="M 375,3 A 72,72 0 0,0 375,147" />
    <path class="bbs-solid-part" d="M 375,3 A 72,72 0 0,1 375,147 Z" />
    <!-- Bottom circle: CX=375, CY=219, R=72 -->
    <path class="bbs-dotted-part" d="M 375,147 A 72,72 0 0,0 375,291" />
    <path class="bbs-solid-part" d="M 375,147 A 72,72 0 0,1 375,291 Z" />
  </g>

  <!-- TEXT: BEG BORROW STEAL -->
  <text x="270" y="420" class="bbs-text-line1">BEG BORROW STEAL</text>

  <!-- TEXT: STUDIO -->
  <text x="286" y="525" class="bbs-text-line2">STUDIO</text>
</svg>