{%- liquid
  assign raw_price = price | default: 0
  assign price_in_rupees = raw_price | divided_by: 100
  assign price_cents = raw_price | modulo: 100

  if price_cents < 10
    assign cents_str = '0' | append: price_cents
  else
    assign cents_str = price_cents | append: ''
  endif

  if price_in_rupees < 1000
    assign formatted_int = price_in_rupees | append: ''
  elsif price_in_rupees < 100000
    assign thousands = price_in_rupees | divided_by: 1000
    assign rem_hundreds = price_in_rupees | modulo: 1000
    if rem_hundreds < 10
      assign hundreds_str = '00' | append: rem_hundreds
    elsif rem_hundreds < 100
      assign hundreds_str = '0' | append: rem_hundreds
    else
      assign hundreds_str = rem_hundreds | append: ''
    endif
    assign formatted_int = thousands | append: ',' | append: hundreds_str
  elsif price_in_rupees < 10000000
    assign lakhs = price_in_rupees | divided_by: 100000
    assign rem_lakhs = price_in_rupees | modulo: 100000
    assign thousands = rem_lakhs | divided_by: 1000
    if thousands < 10
      assign thousands_str = '0' | append: thousands
    else
      assign thousands_str = thousands | append: ''
    endif
    assign rem_hundreds = rem_lakhs | modulo: 1000
    if rem_hundreds < 10
      assign hundreds_str = '00' | append: rem_hundreds
    elsif rem_hundreds < 100
      assign hundreds_str = '0' | append: rem_hundreds
    else
      assign hundreds_str = rem_hundreds | append: ''
    endif
    assign formatted_int = lakhs | append: ',' | append: thousands_str | append: ',' | append: hundreds_str
  else
    assign crores = price_in_rupees | divided_by: 10000000
    assign rem_crores = price_in_rupees | modulo: 10000000
    assign lakhs = rem_crores | divided_by: 100000
    if lakhs < 10
      assign lakhs_str = '0' | append: lakhs
    else
      assign lakhs_str = lakhs | append: ''
    endif
    assign rem_lakhs = rem_crores | modulo: 100000
    assign thousands = rem_lakhs | divided_by: 1000
    if thousands < 10
      assign thousands_str = '0' | append: thousands
    else
      assign thousands_str = thousands | append: ''
    endif
    assign rem_hundreds = rem_lakhs | modulo: 1000
    if rem_hundreds < 10
      assign hundreds_str = '00' | append: rem_hundreds
    elsif rem_hundreds < 100
      assign hundreds_str = '0' | append: rem_hundreds
    else
      assign hundreds_str = rem_hundreds | append: ''
    endif
    assign formatted_int = crores | append: ',' | append: lakhs_str | append: ',' | append: thousands_str | append: ',' | append: hundreds_str
  endif

  echo 'Rs. ' | append: formatted_int | append: '.' | append: cents_str
-%}