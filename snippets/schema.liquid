{%- liquid
    assign shop_url = shop.url
    assign page_type = request.page_type
    assign default_logo = 'https://begborrowstealstudio.com/cdn/shop/files/ChatGPT_Image_Jul_11_2026_04_59_32_PM.png?v=1783769391'
    if settings.favicon != blank
        assign default_logo = settings.favicon | img_url: 'master' | prepend: 'https:'
    endif
-%}

{%- comment -%} ================= GLOBAL / HOMEPAGE SCHEMAS ================= {%- endcomment -%}
{%- if page_type == 'index' -%}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Beg Borrow Steal Studio",
    "url": "{{ shop_url }}",
    "potentialAction": {
        "@type": "SearchAction",
        "target": {
            "@type": "EntryPoint",
            "urlTemplate": "{{ shop_url }}/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
    }
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "JewelryStore",
    "name": "Beg Borrow Steal Studio",
    "image": "{{ default_logo }}",
    "url": "{{ shop_url }}",
    "telephone": "+919136047270",
    "email": "begborrowstealstudio@gmail.com",
    "priceRange": "$$",
    "description": "Mumbai's premier boutique destination for authenticated vintage designer jewellery, archival timepieces, luxury accessories, and rare curated collectibles.",
    "founder": [
        {
            "@type": "Person",
            "name": "Pranav Sood",
            "jobTitle": "Co-Founder & Creative Director"
        },
        {
            "@type": "Person",
            "name": "Krisna Krishnankutty",
            "jobTitle": "Co-Founder & Stylist"
        }
    ],
    "address": {
        "@type": "PostalAddress",
        "streetAddress": "76 Turner Road, New Shams Building, Bandra West",
        "addressLocality": "Mumbai",
        "addressRegion": "Maharashtra",
        "postalCode": "400050",
        "addressCountry": "IN"
    },
    "geo": {
        "@type": "GeoCoordinates",
        "latitude": 19.0573,
        "longitude": 72.8296
    },
    "openingHoursSpecification": [
        {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
                "Monday",
                "Tuesday",
                "Wednesday",
                "Thursday",
                "Friday",
                "Saturday"
            ],
            "opens": "11:00",
            "closes": "20:00"
        }
    ],
    "sameAs": [
        "https://www.instagram.com/begborrowstealstudio"
        {%- if settings.social_facebook_link != blank and settings.social_facebook_link != '' -%}, "{{ settings.social_facebook_link }}"{%- endif -%}
        {%- if settings.social_twitter_link != blank and settings.social_twitter_link != '' -%}, "{{ settings.social_twitter_link }}"{%- endif -%}
        {%- if settings.social_pinterest_link != blank and settings.social_pinterest_link != '' -%}, "{{ settings.social_pinterest_link }}"{%- endif -%}
    ]
}
</script>
{%- endif -%}

{%- comment -%} ================= PRODUCT SCHEMA ================= {%- endcomment -%}
{%- if page_type == 'product' -%}
{%- liquid
    assign current_variant = product.selected_or_first_available_variant
    assign product_desc = product.description | strip_html | strip_newlines | escape
    if product_desc == blank
        assign product_desc = product.title | escape
    endif
-%}
<script type="application/ld+json">
{
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": "{{ product.title | strip_html | escape }}",
    "url": "{{ shop_url }}{{ product.url }}",
    "@id": "{{ shop_url }}{{ product.url }}#product",
    "sku": "{{ current_variant.sku | default: current_variant.id }}",
    "brand": {
        "@type": "Brand",
        "name": "{{ product.vendor | default: 'Beg Borrow Steal Studio' | escape }}"
    },
    "description": "{{ product_desc }}",
    "image": [
        {%- for img in product.images limit: 8 -%}
            "https:{{ img.src | img_url: 'master' }}"{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
    ],
    "itemCondition": "https://schema.org/UsedCondition",
    "offers": {
        "@type": "Offer",
        "url": "{{ shop_url }}{{ product.url }}",
        "priceCurrency": "{{ cart.currency.iso_code | default: shop.currency }}",
        "price": "{{ current_variant.price | divided_by: 100.00 | json }}",
        "itemCondition": "https://schema.org/UsedCondition",
        "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "priceValidUntil": "{{ 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d' }}",
        "seller": {
            "@type": "JewelryStore",
            "name": "Beg Borrow Steal Studio",
            "url": "{{ shop_url }}"
        }
    }
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org/",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "{{ shop_url }}"
        }
        {%- if collection -%}
        ,{
            "@type": "ListItem",
            "position": 2,
            "name": "{{ collection.title | escape }}",
            "item": "{{ shop_url }}/collections/{{ collection.handle }}"
        },
        {
            "@type": "ListItem",
            "position": 3,
            "name": "{{ product.title | escape }}",
            "item": "{{ canonical_url }}"
        }
        {%- else -%}
        ,{
            "@type": "ListItem",
            "position": 2,
            "name": "{{ product.title | escape }}",
            "item": "{{ canonical_url }}"
        }
        {%- endif -%}
    ]
}
</script>
{%- endif -%}

{%- comment -%} ================= COLLECTION SCHEMA ================= {%- endcomment -%}
{%- if page_type == 'collection' and collection.handle -%}
{%- liquid
    assign col_desc = collection.description | split: '[lang2]' | first | strip_html | strip_newlines | escape
    if col_desc == blank
        assign col_desc = "Discover authentic vintage " | append: collection.title | append: " and archival luxury pieces at Beg Borrow Steal Studio." | escape
    endif
-%}
<script type="application/ld+json">
{
    "@context": "https://schema.org/",
    "@type": "CollectionPage",
    "name": "{{ collection.title | escape }}",
    "url": "{{ canonical_url }}",
    "description": "{{ col_desc }}",
    "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ collection.products_count | default: 20 }},
        "itemListElement": [
            {%- for prod in collection.products limit: 12 -%}
            {
                "@type": "ListItem",
                "position": {{ forloop.index }},
                "url": "{{ shop_url }}{{ prod.url }}",
                "name": "{{ prod.title | strip_html | escape }}"
            }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
        ]
    }
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org/",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "{{ shop_url }}"
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "{{ collection.title | escape }}",
            "item": "{{ canonical_url }}"
        }
    ]
}
</script>
{%- endif -%}

{%- comment -%} ================= ARTICLE SCHEMA ================= {%- endcomment -%}
{%- if page_type == 'article' -%}
<script type="application/ld+json">
{{ article | structured_data }}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org/",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "{{ shop_url }}"
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "{{ article.title | escape }}",
            "item": "{{ canonical_url }}"
        }
    ]
}
</script>
{%- endif -%}

{%- comment -%} ================= GENERAL PAGE BREADCRUMBS ================= {%- endcomment -%}
{%- if page_type == 'page' -%}
<script type="application/ld+json">
{
    "@context": "https://schema.org/",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "{{ shop_url }}"
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "{{ page.title | escape }}",
            "item": "{{ canonical_url }}"
        }
    ]
}
</script>
{%- endif -%}

{%- comment -%} ================= FAQ SCHEMA (AEO & AI SEARCH OPTIMIZATION) ================= {%- endcomment -%}
{%- if page_type == 'index' or page.handle == 'about-us' or page.handle == 'vintage-designer-jewellery' -%}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
        {
            "@type": "Question",
            "name": "Are all vintage designer jewellery and accessories at Beg Borrow Steal Studio authentic?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. Every vintage designer piece at Beg Borrow Steal Studio undergoes rigorous multi-point authentication for brand hallmarks, craftsmanship, date stamps, and materials before being curated for sale."
            }
        },
        {
            "@type": "Question",
            "name": "Where is Beg Borrow Steal Studio located?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Beg Borrow Steal Studio is located at 1, New Shams Building, 76 Turner Road, Bandra West, Mumbai, Maharashtra 400050, India."
            }
        },
        {
            "@type": "Question",
            "name": "Who founded Beg Borrow Steal Studio?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Beg Borrow Steal Studio was founded by fashion stylists and creative visionaries Pranav Sood and Krisna Krishnankutty."
            }
        },
        {
            "@type": "Question",
            "name": "What designer brands does Beg Borrow Steal Studio curate?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Beg Borrow Steal Studio curates authenticated archival and vintage collections from iconic fashion houses including Chanel, Christian Dior, Yves Saint Laurent, Givenchy, Celine, Lanvin, and Christian Lacroix."
            }
        },
        {
            "@type": "Question",
            "name": "What is the condition of items sold at Beg Borrow Steal Studio?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "All pieces are rare archival and vintage items. Each listing features detailed condition grading and high-resolution imagery showcasing their authentic vintage patina and preserved beauty."
            }
        }
    ]
}
</script>
{%- endif -%}
