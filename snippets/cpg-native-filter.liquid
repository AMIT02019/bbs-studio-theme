{%- comment -%}
    Renders one native storefront facet (a collection.filters item) for the
    collection grid. Extracted from collection-product-grid.liquid so facets
    can be rendered in a custom order (e.g. Brand/Vendor before Product type).

    Accepts:
      filter       - a collection.filters item
      index        - unique value used for element ids
      csd          - collapse-default flag ('close' = start collapsed)
      section      - the section (for settings)
      forced_fl    - optional override for filter label (e.g. 'brands', 'product type')
      forced_label - optional override for display header
{%- endcomment -%}
{%- assign limit = section.settings.max_item_per_filter | default: 10 -%}
{%- assign fl = filter.label | downcase -%}
{%- if forced_fl != blank -%}{%- assign fl = forced_fl -%}{%- endif -%}
{%- assign display_title = filter.label | default: forced_label | default: index -%}
{%- assign sw_label = section.settings.filter_swatch | downcase -%}
{%- assign sz_label = section.settings.filter_rectangle | downcase -%}
{%- assign cur = currency | default: '₹' -%}

{%- assign is_home_decor = false -%}
{%- assign hd_handles = 'indian-antique,crockery,african,islamic,japanese-artifacts,ceramic,artwork,christian-art,european-art,chinese-art,home-decor-curios,home-decor' | split: ',' -%}
{%- if hd_handles contains collection.handle -%}
  {%- assign is_home_decor = true -%}
{%- endif -%}

{%- if is_home_decor and fl == 'brands' or is_home_decor and fl == 'brand' or is_home_decor and fl == 'vendor' -%}
  {%- assign display_title = 'Category' -%}
{%- endif -%}

<div class="cpg-filter-group {% if csd == 'close' %}is-collapsed{% endif %}" id="cpg-fg-{% if is_home_decor and fl == 'brands' or is_home_decor and fl == 'brand' or is_home_decor and fl == 'vendor' %}Category{% else %}{{ index }}{% endif %}">
  <div class="cpg-filter-title" onclick="cpgToggleFilter('cpg-fg-{% if is_home_decor and fl == 'brands' or is_home_decor and fl == 'brand' or is_home_decor and fl == 'vendor' %}Category{% else %}{{ index }}{% endif %}')">
    <span>{{ display_title }}</span>
    <span class="cpg-toggle-icon">{% if csd == 'close' %}+{% else %}−{% endif %}</span>
  </div>
  <div class="cpg-filter-body">

    {%- if filter.type == 'price_range' -%}
      {%- assign min_val_unit = '' -%}
      {%- if filter.min_value.value != blank -%}
        {%- assign min_val_unit = filter.min_value.value | divided_by: 100.0 | floor -%}
      {%- endif -%}
      {%- assign max_val_unit = '' -%}
      {%- if filter.max_value.value != blank -%}
        {%- assign max_val_unit = filter.max_value.value | divided_by: 100.0 | ceil -%}
      {%- endif -%}
      <div class="cpg-price-inputs">
        <div class="cpg-price-field">
          <span>{{ cur }}</span>
          <input type="number" id="cpg-pmin" name="{{ filter.min_value.param_name }}"
            value="{{ min_val_unit }}"
            min="0" placeholder="Min"
            aria-label="Minimum price"
            onkeydown="if(event.key==='Enter'){event.preventDefault();cpgApplyPrice();}">
        </div>
        <div style="display:flex;align-items:center;color:#bbb;padding:0 2px;">–</div>
        <div class="cpg-price-field">
          <span>{{ cur }}</span>
          <input type="number" id="cpg-pmax" name="{{ filter.max_value.param_name }}"
            value="{{ max_val_unit }}"
            min="0" placeholder="Max"
            aria-label="Maximum price"
            onkeydown="if(event.key==='Enter'){event.preventDefault();cpgApplyPrice();}">
        </div>
      </div>
      <button type="button" class="cpg-price-apply" onclick="cpgApplyPrice()">Apply</button>

    {%- elsif filter.type == 'boolean' -%}
      {%- for v in filter.values -%}
        <label class="cpg-filter-option">
          <input type="checkbox" {% if v.active %}checked{% endif %}
            onchange="window.location='{% if v.active %}{{ v.url_to_remove }}{% else %}{{ v.url_to_add }}{% endif %}'">
          {{ v.label }}
          <span class="cpg-filter-count">({{ v.count }})</span>
        </label>
      {%- endfor -%}

    {%- elsif filter.type == 'list' or is_home_decor or fl == 'product type' -%}

      {%- if fl == sw_label -%}
        {%- comment -%} Color swatches {%- endcomment -%}
        {%- assign sw_layout = section.settings.filter_swatch_layout -%}
        {%- if sw_layout == 'name' or sw_layout == 'count' -%}
          {%- for v in filter.values -%}
            <label class="cpg-filter-option">
              <input type="checkbox" {% if v.active %}checked{% endif %}
                onchange="window.location='{% if v.active %}{{ v.url_to_remove }}{% else %}{{ v.url_to_add }}{% endif %}'">
              {{ v.label }}{% if sw_layout == 'count' %} <span class="cpg-filter-count">({{ v.count }})</span>{% endif %}
            </label>
          {%- endfor -%}
        {%- else -%}
          <div class="cpg-swatches">
            {%- for v in filter.values -%}
              <a href="{% if v.active %}{{ v.url_to_remove }}{% else %}{{ v.url_to_add }}{% endif %}"
                title="{{ v.label }} ({{ v.count }})">
                {%- if section.settings.filter_swatch_type == 'png' -%}
                  <span class="cpg-swatch {% if v.active %}is-active{% endif %}"
                    style="background-image:url({{ v.label | handle | append: '.png' | file_url }});background-size:cover;">
                  </span>
                {%- else -%}
                  <span class="cpg-swatch {% if v.active %}is-active{% endif %}"
                    style="background-color:{{ v.label | downcase }};">
                  </span>
                {%- endif -%}
              </a>
            {%- endfor -%}
          </div>
        {%- endif -%}

      {%- elsif fl == sz_label -%}
        {%- comment -%} Size buttons {%- endcomment -%}
        <div class="cpg-sizes">
          {%- for v in filter.values -%}
            <a class="cpg-size-btn {% if v.active %}is-active{% endif %}"
              href="{% if v.active %}{{ v.url_to_remove }}{% else %}{{ v.url_to_add }}{% endif %}">
              {{ v.label }}
            </a>
          {%- endfor -%}
        </div>

      {%- elsif is_home_decor and fl == 'brands' or is_home_decor and fl == 'brand' or is_home_decor and fl == 'vendor' -%}
        {%- comment -%} Home Decor Subcategories under CATEGORY heading {%- endcomment -%}
        {%- assign hd_brands = 'indian-antique:Indian Antique:89,crockery:Ceramics:6,african:African Artifacts:2,islamic:Islamic Artifacts:10,japanese-artifacts:Japanese Artifacts:47,ceramic:Crockery:28,artwork:Artwork:0,christian-art:Christian Art:0,european-art:European Artifacts:12,chinese-art:Chinese Artifacts:7' | split: ',' -%}
        {%- for item in hd_brands -%}
          {%- assign parts = item | split: ':' -%}
          {%- assign col_h = parts[0] -%}
          {%- assign col_title = parts[1] -%}
          {%- assign col_fallback = parts[2] | plus: 0 -%}
          {%- assign col_live = collections[col_h].all_products_count -%}
          {%- if col_live != blank and col_live >= 0 -%}
            {%- assign col_cnt = col_live -%}
          {%- else -%}
            {%- assign col_cnt = col_fallback -%}
          {%- endif -%}
          {%- assign is_act = false -%}
          {%- if collection.handle == col_h -%}
            {%- assign is_act = true -%}
          {%- endif -%}
          {%- if is_act -%}
            {%- assign target_dest = '/collections/home-decor-curios' -%}
          {%- else -%}
            {%- assign target_dest = '/collections/' | append: col_h -%}
          {%- endif -%}
          <label class="cpg-filter-option {% if is_act %}is-active{% endif %}">
            <input type="checkbox" {% if is_act %}checked{% endif %}
              onchange="window.location='{{ target_dest }}'">
            {{ col_title }}
            <span class="cpg-filter-count">({{ col_cnt }})</span>
          </label>
        {%- endfor -%}

      {%- elsif fl == 'product type' -%}
        {%- comment -%} Store Product Types: Jewellery, Clothing, Watches, Sunglasses, Bags, Home Decor, Textiles {%- endcomment -%}
        {%- assign pt_items = 'jewellery:Jewellery:/pages/designer-jewellery:269,clothing:Clothing:/collections/clothing:127,watches:Watches:/collections/watches:60,sunglasses:Sunglasses:/collections/sunglasses:22,bags:Bags:/collections/bags:42,home-decor:Home Decor:/collections/home-decor-curios:202,textiles:Textiles:/collections/textiles:22' | split: ',' -%}
        {%- for item in pt_items -%}
          {%- assign parts = item | split: ':' -%}
          {%- assign pt_key = parts[0] -%}
          {%- assign pt_name = parts[1] -%}
          {%- assign pt_url = parts[2] -%}
          {%- assign pt_fallback = parts[3] | plus: 0 -%}
          {%- assign pt_col_count = collections[pt_key].all_products_count -%}
          {%- if pt_key == 'home-decor' -%}
            {%- assign pt_col_count = collections['home-decor-curios'].all_products_count -%}
          {%- endif -%}
          {%- if pt_col_count != blank and pt_col_count > 0 -%}
            {%- assign pt_cnt = pt_col_count -%}
          {%- else -%}
            {%- assign pt_cnt = pt_fallback -%}
          {%- endif -%}
          {%- assign is_pt_active = false -%}
          {%- if pt_key == 'home-decor' and is_home_decor -%}
            {%- assign is_pt_active = true -%}
          {%- elsif collection.handle == pt_key -%}
            {%- assign is_pt_active = true -%}
          {%- elsif pt_key == 'bags' and collection.handle == 'designer-bags' -%}
            {%- assign is_pt_active = true -%}
          {%- elsif pt_key == 'clothing' and collection.handle == 'vintage-clothing' or collection.handle == 'designer-clothing' or collection.handle == 'denim-jacket' -%}
            {%- assign is_pt_active = true -%}
          {%- endif -%}
          <label class="cpg-filter-option {% if is_pt_active %}is-active{% endif %}">
            <input type="checkbox" {% if is_pt_active %}checked{% endif %}
              onchange="window.location='{{ pt_url }}'">
            {{ pt_name }}
            <span class="cpg-filter-count">({{ pt_cnt }})</span>
          </label>
        {%- endfor -%}

      {%- else -%}
        {%- comment -%} Default checkbox list {%- endcomment -%}
        {%- assign display_type = section.settings.filter_display_type -%}
        {%- for v in filter.values -%}
          <label class="cpg-filter-option{% if forloop.index > limit %} cpg-extra{% endif %}"
            {% if forloop.index > limit and display_type == 'show-more' %}style="display:none"{% endif %}>
            <input type="checkbox" {% if v.active %}checked{% endif %}
              onchange="window.location='{% if v.active %}{{ v.url_to_remove }}{% else %}{{ v.url_to_add }}{% endif %}'">
            {{ v.label }}
            <span class="cpg-filter-count">({{ v.count }})</span>
          </label>
        {%- endfor -%}
        {%- if display_type == 'show-more' and filter.values.size > limit -%}
          <span class="cpg-filter-show-more" onclick="cpgShowMore(this)">+ {{ filter.values.size | minus: limit }} more</span>
        {%- endif -%}
      {%- endif -%}

    {%- endif -%}
  </div>
</div>
