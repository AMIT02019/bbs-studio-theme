{%- comment -%}
    Renders one block-based tag filter (section.blocks item of type 'filter')
    for the collection sidebar, skipping it if a native facet with the same
    heading already exists or if the heading is in hidden_filters.

    Accepts:
      block          - a section.blocks item (type == 'filter')
      native_labels  - pipe-delimited lowercase list of native facet labels
      hidden_filters - pipe-delimited lowercase list of hidden filter labels
      csd            - collapse-default flag ('close' = start collapsed)
{%- endcomment -%}
{%- assign block_heading = block.settings.heading | downcase | strip -%}
{%- assign block_check = '|' | append: block_heading | append: '|' -%}
{%- assign skip_block = false -%}
{%- if block_heading == blank -%}
  {%- assign skip_block = true -%}
{%- elsif native_labels contains block_check -%}
  {%- assign skip_block = true -%}
{%- elsif block_heading == 'brand' or block_heading == 'brands' or block_heading == 'vendor' -%}
  {%- if native_labels contains '|brand|' or native_labels contains '|brands|' or native_labels contains '|vendor|' -%}
    {%- assign skip_block = true -%}
  {%- endif -%}
{%- elsif hidden_filters contains block_check -%}
  {%- assign skip_block = true -%}
{%- endif -%}
{%- unless skip_block -%}
  {%- assign tags = block.settings.list_tags | split: ',' -%}
  {%- assign has_any = false -%}
  {%- for t in tags -%}
    {%- assign tag = t | strip -%}
    {%- if collection.all_tags contains tag -%}{%- assign has_any = true -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
  {%- if has_any -%}
  <div class="cpg-filter-group {% if csd == 'close' %}is-collapsed{% endif %}" id="cpg-blk-{{ block.id }}" {{ block.shopify_attributes }}>
    <div class="cpg-filter-title" onclick="cpgToggleFilter('cpg-blk-{{ block.id }}')">
      <span>{{ block.settings.heading }}</span>
      <span class="cpg-toggle-icon">{% if csd == 'close' %}+{% else %}−{% endif %}</span>
    </div>
    <div class="cpg-filter-body">
      {%- for t in tags -%}
        {%- assign tag = t | strip -%}
        {%- assign tag_dc = tag | downcase -%}
        {%- if collection.all_tags contains tag -%}
          <label class="cpg-filter-option">
            <input type="checkbox"
              {% if current_tags contains tag %}checked{% endif %}
              onchange="cpgToggleTag('{{ tag | handle }}')">
            {{ tag }}
          </label>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}
{%- endunless -%}
