    scrollbar-width: thin !important;
    scrollbar-color: #8c7355 #f4ede4 !important;
  }
</style>

<script>
(function() {
  function setActiveCategory(catKey, container) {
    if (!catKey) return null;
    var scope = container || document;
    var triggers = scope.querySelectorAll('.bbs-mm-cat-trigger');
    var panels = scope.querySelectorAll('.bbs-mm-subcat-panel');

    for (var i = 0; i < triggers.length; i++) {
      if (triggers[i].getAttribute('data-cat') === catKey) {
        triggers[i].classList.add('is-active');
      } else {
        triggers[i].classList.remove('is-active');
      }
    }
    var activePanel = null;
    for (var j = 0; j < panels.length; j++) {
      if (panels[j].getAttribute('data-subcat') === catKey) {
        panels[j].classList.add('is-active');
        activePanel = panels[j];
      } else {
        panels[j].classList.remove('is-active');
      }
    }
    return activePanel;
  }

  // Universal click / tap delegation (works seamlessly on mobile drawers & cloned nodes)
  document.addEventListener('click', function(e) {
    // 1. Category circle trigger clicked
    var trigger = e.target.closest('.bbs-mm-cat-trigger');
    if (trigger) {
      var dropdown = trigger.closest('.bbs-luxury-megamenu-dropdown');
      var cat = trigger.getAttribute('data-cat');
      if (cat) {
        e.preventDefault();
        e.stopPropagation();
        var panel = setActiveCategory(cat, dropdown);
        if (window.innerWidth < 1025 && panel) {
          setTimeout(function() {
            panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }, 80);
        }
      }
      return;
    }

    // 2. Mobile back button
    var backBtn = e.target.closest('[data-bbs-mm-back]');
    if (backBtn) {
      e.preventDefault();
      e.stopPropagation();
      var parentItem = backBtn.closest('.has-bbs-luxury-megamenu') || backBtn.closest('.menu-lv-item');
      if (parentItem) {
        parentItem.classList.remove('is-open');
        parentItem.classList.remove('is-active');
      }
      return;
    }

    // 3. Mobile category toggle in drawer (< 1025px)
    if (window.innerWidth < 1025) {
      var mobileAction = e.target.closest('.site-nav-mobile .has-bbs-luxury-megamenu > .menu-lv-1__action, .site-nav-mobile .has-bbs-luxury-megamenu [data-toggle-menu-mb], .halo-sidebar_menu .has-bbs-luxury-megamenu > .menu-lv-1__action, .halo-sidebar_menu .has-bbs-luxury-megamenu [data-toggle-menu-mb], #navigation-mobile .has-bbs-luxury-megamenu > .menu-lv-1__action, #navigation-mobile .has-bbs-luxury-megamenu [data-toggle-menu-mb]');
      if (mobileAction) {
        e.preventDefault();
        e.stopPropagation();
        var navItem = mobileAction.closest('.has-bbs-luxury-megamenu');
        if (navItem) {
          var willOpen = !navItem.classList.contains('is-open') && !navItem.classList.contains('is-active');
          if (willOpen) {
            navItem.classList.add('is-open', 'is-active');
          } else {
            navItem.classList.remove('is-open', 'is-active');
          }
        }
        return;
      }
    }

    // 4. Reset menu state if drawer closed
    if (e.target.closest('.halo-sidebar-close, .background-overlay')) {
      var openItems = document.querySelectorAll('.has-bbs-luxury-megamenu.is-open, .has-bbs-luxury-megamenu.is-active');
      openItems.forEach(function(item) {
        item.classList.remove('is-open');
        item.classList.remove('is-active');
      });
    }
  }, true);

  // Desktop hover subcategory switcher
  document.addEventListener('mouseover', function(e) {
    if (window.innerWidth >= 1025) {
      var trigger = e.target.closest('.bbs-mm-cat-trigger');
      if (trigger) {
        var dropdown = trigger.closest('.bbs-luxury-megamenu-dropdown');
        var cat = trigger.getAttribute('data-cat');
        if (cat) {
          setActiveCategory(cat, dropdown);
        }
      }
    }
  });

  // Desktop mega menu reveal on navigation hover
  var closeTimer = null;
  function setupDesktopHover() {
    var navItems = document.querySelectorAll('.has-bbs-luxury-megamenu');
    navItems.forEach(function(item) {
      var dd = item.querySelector('.bbs-luxury-megamenu-dropdown');
      var navLink = item.querySelector('.menu-lv-1__action');
      if (!dd) return;

      function show() {
        if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
        item.classList.add('is-active');
        dd.classList.add('is-visible');
      }
      function hide() {
        closeTimer = setTimeout(function() {
          item.classList.remove('is-active');
          dd.classList.remove('is-visible');
        }, 220);
      }

      item.addEventListener('mouseenter', show);
      item.addEventListener('mouseleave', hide);
      dd.addEventListener('mouseenter', show);
      dd.addEventListener('mouseleave', hide);

      if (navLink && !navLink.dataset.bbsHoverInit) {
        navLink.dataset.bbsHoverInit = 'true';
        navLink.addEventListener('click', function(e) {
          if (window.innerWidth >= 1025) {
            e.preventDefault();
          }
        });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupDesktopHover);
  } else {
    setupDesktopHover();
  }
  document.addEventListener('shopify:section:load', setupDesktopHover);
})();
</script>
