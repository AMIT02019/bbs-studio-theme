<script>
(function() {
  function initBbsMegamenu() {
    var navItem = document.querySelector('.has-bbs-luxury-megamenu');
    if (!navItem) return;

    var dropdown = navItem.querySelector('.bbs-luxury-megamenu-dropdown');
    var navLink = navItem.querySelector('.menu-lv-1__action');
    var closeTimer = null;

    if (window.innerWidth >= 1025) {
      function showMenu() {
        if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
        navItem.classList.add('is-active');
        if (dropdown) dropdown.classList.add('is-visible');
      }

      function hideMenu() {
        closeTimer = setTimeout(function() {
          navItem.classList.remove('is-active');
          if (dropdown) dropdown.classList.remove('is-visible');
        }, 180);
      }

      navItem.addEventListener('mouseenter', showMenu);
      navItem.addEventListener('mouseleave', hideMenu);
      if (dropdown) {
        dropdown.addEventListener('mouseenter', showMenu);
        dropdown.addEventListener('mouseleave', hideMenu);
      }

      if (navLink) {
        navLink.addEventListener('click', function(e) {
          if (window.innerWidth >= 1025) {
            e.preventDefault();
          }
        });
      }
    }

    function setupMobileEvents() {
      var mobileNavItems = document.querySelectorAll('.site-nav-mobile .has-bbs-luxury-megamenu');
      mobileNavItems.forEach(function(item) {
        var link = item.querySelector('.menu-lv-1__action');
        var backBtn = item.querySelector('[data-bbs-mm-back]');

        if (link && !link.dataset.bbsInit) {
          link.dataset.bbsInit = 'true';
          link.addEventListener('click', function(e) {
            if (window.innerWidth < 1025) {
              e.preventDefault();
              e.stopPropagation();
              item.classList.toggle('is-open');
            }
          });
        }

        if (backBtn && !backBtn.dataset.bbsInit) {
          backBtn.dataset.bbsInit = 'true';
          backBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            item.classList.remove('is-open');
          });
        }
      });
    }

    setupMobileEvents();
    document.addEventListener('shopify:section:load', setupMobileEvents);
    document.addEventListener('click', function(e) {
      if (e.target.closest('.header-mobile--icon, [data-mobile-menu]')) {
        setTimeout(setupMobileEvents, 300);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBbsMegamenu);
  } else {
    initBbsMegamenu();
  }
})();
</script>
