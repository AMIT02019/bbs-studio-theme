{%- comment -%}
  Beg Borrow Steal Studio - Interactive FAQ Section
{%- endcomment -%}

{% render 'bbs-faq' %}

{% schema %}
{
  "name": "BBS FAQs",
  "tag": "section",
  "class": "section-bbs-faq",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "NEED HELP?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FREQUENTLY ASKED QUESTIONS"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Everything you need to know about our curation, authenticity, condition, and private appointments."
    }
  ],
  "presets": [
    {
      "name": "BBS FAQs"
    }
  ]
}
{% endschema %}