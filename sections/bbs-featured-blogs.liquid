{%- liquid
  assign selected_blog = blogs[section.settings.blog]
  if selected_blog == blank or selected_blog.articles_count == 0
    assign selected_blog = blogs['news']
  endif
  assign post_limit = section.settings.post_limit | default: 3
  assign articles_to_show = selected_blog.articles.size
  if articles_to_show > post_limit
    assign articles_to_show = post_limit
  endif
-%}

<style>
  #bbs-featured-blogs-{{ section.id }} {
    background-color: {{ section.settings.background_color | default: '#faf8f5' }};
    padding-top: {{ section.settings.padding_top | default: 75 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    border-top: 1px solid rgba(90, 58, 10, 0.08);
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-container {
    max-width: {{ section.settings.max_width | default: 1280 }}px;
    margin: 0 auto;
    padding: 0 55px;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-header {
    text-align: center;
    margin-bottom: 50px;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-kicker {
    display: block;
    font-family: sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #8c6239;
    margin-bottom: 10px;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-heading {
    font-size: {{ section.settings.heading_size | default: 34 }}px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: {{ section.settings.heading_color | default: '#5a3a0a' }};
    margin: 0 0 16px 0;
    line-height: 1.25;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-divider {
    width: 80px;
    height: 1.5px;
    background: #d4af37;
    margin: 0 auto 16px auto;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-subtitle {
    font-size: 15px;
    color: #5c4433;
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.6;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-grid {
    display: grid;
    grid-template-columns: repeat({% if articles_to_show == 2 %}2{% elsif articles_to_show == 1 %}1{% else %}3{% endif %}, 1fr);
    gap: 36px;
    {% if articles_to_show == 2 %}
    max-width: 1120px;
    margin: 0 auto;
    {% elsif articles_to_show == 1 %}
    max-width: 640px;
    margin: 0 auto;
    {% endif %}
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-card {
    background: #ffffff;
    border: 1px solid rgba(90, 58, 10, 0.12);
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
    box-shadow: 0 8px 28px rgba(44, 24, 16, 0.04);
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 48px rgba(44, 24, 16, 0.11);
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-img-wrap {
    position: relative;
    display: block;
    width: 100%;
    padding-top: 66%;
    overflow: hidden;
    background: #f3ede4;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-img-wrap img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.55s ease;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-card:hover .bbs-fb-img-wrap img {
    transform: scale(1.05);
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    background: rgba(43, 24, 16, 0.88);
    color: #f5dfb8;
    font-family: sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 2px;
    border: 1px solid rgba(212, 175, 55, 0.45);
    z-index: 2;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-body {
    padding: 30px 32px 32px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-meta {
    font-family: sans-serif;
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8c6239;
    margin-bottom: 10px;
    font-weight: 600;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-title {
    font-family: 'Georgia', 'Times New Roman', serif;
    font-size: 21px;
    font-weight: 600;
    line-height: 1.4;
    color: #2c1810;
    margin: 0 0 14px 0;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-title a:hover {
    color: #8c6239;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-excerpt {
    font-size: 14.5px;
    line-height: 1.7;
    color: #523d30;
    margin: 0 0 22px 0;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-readmore {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #5a3a0a;
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 1.5px solid #c8a97e;
    align-self: flex-start;
    transition: all 0.25s ease;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-readmore:hover {
    color: #2b1810;
    border-bottom-color: #2b1810;
    gap: 12px;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-footer {
    text-align: center;
    margin-top: 48px;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-viewall {
    display: inline-block;
    background: #2c2c2c;
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
    font-family: sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 16px 40px;
    transition: background 0.25s ease, transform 0.25s ease;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-viewall:hover {
    background: #5a3a0a;
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
    transform: translateY(-2px);
  }
  @media (max-width: 991px) {
    #bbs-featured-blogs-{{ section.id }} .bbs-fb-container {
      padding: 0 24px;
    }
    #bbs-featured-blogs-{{ section.id }} .bbs-fb-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }
  @media (max-width: 767px) {
    #bbs-featured-blogs-{{ section.id }} {
      padding-top: 50px;
      padding-bottom: 55px;
    }
    #bbs-featured-blogs-{{ section.id }} .bbs-fb-container {
      padding: 0 16px;
    }
    #bbs-featured-blogs-{{ section.id }} .bbs-fb-heading {
      font-size: 26px;
    }
    #bbs-featured-blogs-{{ section.id }} .bbs-fb-grid {
      grid-template-columns: 1fr;
    }
    #bbs-featured-blogs-{{ section.id }} .bbs-fb-body {
      padding: 22px 20px 24px;
    }
  }
</style>

{%- if selected_blog != blank and selected_blog.articles.size > 0 -%}
<section id="bbs-featured-blogs-{{ section.id }}" class="bbs-featured-blogs-section">
  <div class="bbs-fb-container">
    <div class="bbs-fb-header">
      {%- if section.settings.kicker != blank -%}
        <span class="bbs-fb-kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h2 class="bbs-fb-heading">{{ section.settings.heading | default: 'FROM OUR BLOGS' }}</h2>
      <div class="bbs-fb-divider"></div>
      {%- if section.settings.subtitle != blank -%}
        <p class="bbs-fb-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="bbs-fb-grid">
      {%- for article in selected_blog.articles limit: post_limit -%}
        <article class="bbs-fb-card">
          <a href="{{ article.url }}" class="bbs-fb-img-wrap">
            <span class="bbs-fb-badge">Featured Spotlight</span>
            {%- if article.image != blank -%}
              <img
                src="{{ article.image | image_url: width: 900 }}"
                alt="{{ article.image.alt | default: article.title | escape }}"
                loading="lazy"
                width="900"
                height="600">
            {%- endif -%}
          </a>
          <div class="bbs-fb-body">
            <div>
              <div class="bbs-fb-meta">
                {{ article.published_at | date: '%B %d, %Y' }} &bull; {{ article.author | default: 'Beg Borrow Steal Studio' }}
              </div>
              <h3 class="bbs-fb-title">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h3>
              <div class="bbs-fb-excerpt">
                {%- if article.excerpt != blank -%}
                  {{ article.excerpt | strip_html | truncatewords: 30 }}
                {%- else -%}
                  {{ article.content | strip_html | truncatewords: 30 }}
                {%- endif -%}
              </div>
            </div>
            <a href="{{ article.url }}" class="bbs-fb-readmore">
              <span>Read Article</span>
              <span>&rarr;</span>
            </a>
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_view_all -%}
      <div class="bbs-fb-footer">
        <a href="{{ selected_blog.url | default: '/blogs/news' }}" class="bbs-fb-viewall">
          {{ section.settings.button_text | default: 'VIEW ALL BLOGS →' }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "BBS Featured Blogs",
  "tag": "section",
  "class": "section-bbs-featured-blogs",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Subheading Kicker",
      "default": "CURATED STORIES & ARTIST SPOTLIGHTS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FROM OUR BLOGS"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "Explore archival stories, provenance notes, and curated exhibitions from our featured artists and collectors."
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Number of posts to show",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "VIEW ALL BLOGS →"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#faf8f5"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#5a3a0a"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 22,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Heading font size",
      "default": 34
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 75
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "BBS Featured Blogs"
    }
  ]
}
{% endschema %}
