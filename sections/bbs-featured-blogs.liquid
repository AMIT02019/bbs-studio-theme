{%- liquid
  assign selected_blog = blogs[section.settings.blog]
  if selected_blog == blank or selected_blog.articles_count == 0
    assign selected_blog = blogs['news']
  endif
  assign post_limit = section.settings.post_limit | default: 2
-%}

<style>
  #bbs-featured-blogs-{{ section.id }} {
    background-color: {{ section.settings.background_color | default: '#fbfaf8' }};
    padding-top: {{ section.settings.padding_top | default: 70 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    border-top: 1px solid #ece7df;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 55px;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-header {
    margin-bottom: 42px;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-heading {
    font-family: 'Georgia', 'Playfair Display', 'Times New Roman', serif !important;
    font-size: 44px !important;
    font-weight: 400 !important;
    color: #36221c !important;
    line-height: 1.15 !important;
    margin: 0 0 10px 0 !important;
    letter-spacing: -0.01em !important;
    text-transform: none !important;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-subtitle {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important;
    font-size: 14px !important;
    letter-spacing: 0.06em !important;
    color: #6e655c !important;
    margin: 0 !important;
    text-transform: none !important;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 52px 48px;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-img-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 16 / 10;
    background: #f2f0ec;
    overflow: hidden;
    margin-bottom: 22px;
    text-decoration: none;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-img-wrap img {
    width: 92%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-card:hover .bbs-fb-img-wrap img {
    transform: scale(1.025);
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-meta {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7a7067;
    margin-bottom: 12px;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-meta .bbs-meta-dot {
    margin: 0 8px;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-title {
    font-family: 'Georgia', 'Playfair Display', 'Times New Roman', serif !important;
    font-size: 28px !important;
    font-weight: 400 !important;
    line-height: 1.28 !important;
    color: #2b1d16 !important;
    margin: 0 0 14px 0 !important;
    text-transform: none !important;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-title a {
    color: inherit !important;
    text-decoration: none !important;
    transition: color 0.2s ease;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-title a:hover {
    color: #6e472b !important;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-excerpt {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    font-size: 14.5px;
    line-height: 1.68;
    color: #5c534b;
    margin: 0 0 24px 0;
    flex-grow: 1;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-readmore {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 11px 22px;
    border: 1px solid #9e9488;
    background: transparent;
    color: #36221c !important;
    -webkit-text-fill-color: #36221c !important;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none !important;
    align-self: flex-start;
    margin-top: auto;
    transition: all 0.25s ease;
  }
  #bbs-featured-blogs-{{ section.id }} .bbs-fb-readmore:hover {
    background: #36221c !important;
    border-color: #36221c !important;
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
  }
  @media (max-width: 991px) {
    #bbs-featured-blogs-{{ section.id }} .bbs-fb-container {
      padding: 0 24px;
    }
    #bbs-featured-blogs-{{ section.id }} .bbs-fb-grid {
      gap: 36px 28px;
    }
    #bbs-featured-blogs-{{ section.id }} .bbs-fb-heading {
      font-size: 36px !important;
    }
    #bbs-featured-blogs-{{ section.id }} .bbs-fb-title {
      font-size: 24px !important;
    }
  }
  @media (max-width: 767px) {
    #bbs-featured-blogs-{{ section.id }} {
      padding-top: 44px;
      padding-bottom: 56px;
    }
    #bbs-featured-blogs-{{ section.id }} .bbs-fb-container {
      padding: 0 18px;
    }
    #bbs-featured-blogs-{{ section.id }} .bbs-fb-heading {
      font-size: 32px !important;
    }
    #bbs-featured-blogs-{{ section.id }} .bbs-fb-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>

{%- if selected_blog != blank and selected_blog.articles.size > 0 -%}
<section id="bbs-featured-blogs-{{ section.id }}" class="bbs-featured-blogs-section">
  <div class="bbs-fb-container">
    <div class="bbs-fb-header">
      <h2 class="bbs-fb-heading">Journal &amp; Stories</h2>
      <p class="bbs-fb-subtitle">Artists, archives and objects with a story to tell.</p>
    </div>

    <div class="bbs-fb-grid">
      {%- for article in selected_blog.articles limit: post_limit -%}
        {%- assign clean_title = article.title | remove: 'Beg Borrow Steal Studio Presents: ' | remove: "'" | remove: "’" | remove: "‘" -%}
        <article class="bbs-fb-card">
          <a href="{{ article.url }}" class="bbs-fb-img-wrap">
            {%- if article.image != blank -%}
              <img
                src="{{ article.image | image_url: width: 1100 }}"
                alt="{{ article.image.alt | default: clean_title | escape }}"
                loading="lazy"
                width="1100"
                height="720">
            {%- endif -%}
          </a>

          <div class="bbs-fb-meta">
            <span>{{ article.published_at | date: '%b %d, %Y' | upcase }}</span>
            <span class="bbs-meta-dot">&bull;</span>
            <span>{{ article.author | default: 'BEG BORROW STEAL STUDIO' | upcase }}</span>
          </div>

          <h3 class="bbs-fb-title">
            <a href="{{ article.url }}">{{ clean_title }}</a>
          </h3>

          <div class="bbs-fb-excerpt">
            {%- if article.excerpt != blank -%}
              {{ article.excerpt | strip_html }}
            {%- else -%}
              {{ article.content | strip_html | truncatewords: 36 }}
            {%- endif -%}
          </div>

          <a href="{{ article.url }}" class="bbs-fb-readmore">
            <span>READ STORY</span>
            <span>&rarr;</span>
          </a>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "BBS Featured Blogs",
  "tag": "section",
  "class": "section-bbs-featured-blogs",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Subheading Kicker",
      "default": "CURATED STORIES & ARTIST SPOTLIGHTS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Journal & Stories"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "Artists, archives and objects with a story to tell."
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Number of posts to show",
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "LOAD MORE STORIES"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fbfaf8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#36221c"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 22,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Heading font size",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "BBS Featured Blogs"
    }
  ]
}
{% endschema %}
