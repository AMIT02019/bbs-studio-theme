{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} {
    {% if section.settings.hide_section %}
      display: none !important;
    {% endif %}
  }

  .category-circles-wrapper {
    background-color: {{ section.settings.bg_color }};
    overflow: hidden;
  }

  .category-circles-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding-left: 25px;
    padding-right: 25px;
    position: relative;
  }

  .category-circles-heading {
    text-align: center;
    margin-bottom: 30px;
    font-size: {{ section.settings.heading_size }}px;
    color: {{ section.settings.heading_color }};
    font-weight: 600;
  }

  .category-circles-scroll-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .category-circles-grid {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    gap: 30px;
    justify-content: flex-start;
    align-items: flex-start;
    padding-bottom: 20px;
    padding-top: 10px;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    width: 100%;
    {% if section.settings.hide_scrollbar %}
      scrollbar-width: none;
      -ms-overflow-style: none;
    {% endif %}
  }

  {% if section.settings.hide_scrollbar %}
    .category-circles-grid::-webkit-scrollbar {
      display: none;
    }
  {% endif %}

  .category-circle-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    flex: 0 0 auto;
    width: {{ section.settings.circle_size | plus: 24 }}px;
    cursor: pointer;
    transition: transform 0.25s ease;
  }

  .category-circle-item:hover {
    transform: translateY(-5px);
  }

  .category-circle-image-wrapper {
    width: {{ section.settings.circle_size }}px;
    height: {{ section.settings.circle_size }}px;
    border-radius: 50%;
    overflow: hidden;
    position: relative;
    background-color: #f4f4f4;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .category-circle-item:hover .category-circle-image-wrapper {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    border-color: rgba(0, 0, 0, 0.25);
  }

  .category-circle-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .category-circle-item:hover .category-circle-image {
    transform: scale(1.08);
  }

  .category-circle-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #e0e0e0 0%, #f5f5f5 100%);
    color: #888;
  }

  .category-circle-placeholder svg {
    width: 40%;
    height: 40%;
    opacity: 0.6;
  }

  .category-circle-title {
    margin-top: 14px;
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: {{ section.settings.title_font_weight }};
    color: {{ section.settings.title_color }};
    text-align: center;
    line-height: 1.3;
    word-break: break-word;
    transition: color 0.2s ease;
  }

  .category-circle-item:hover .category-circle-title {
    color: {{ section.settings.title_hover_color }};
  }

  /* Scroll Navigation Buttons - Hidden by default, visible on hover */
  .category-circle-arrow {
    position: absolute;
    top: calc(50% - 15px);
    transform: translateY(-50%) scale(0.9);
    z-index: 10;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.12);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.3s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  /* Show arrows when user hovers over section wrapper / grid container */
  .category-circles-container:hover .category-circle-arrow,
  .category-circles-scroll-wrapper:hover .category-circle-arrow {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(-50%) scale(1);
  }

  .category-circle-arrow:hover {
    background-color: #f8f8f8;
    transform: translateY(-50%) scale(1.1) !important;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22);
  }

  .category-circle-arrow-prev {
    left: -15px;
  }

  .category-circle-arrow-next {
    right: -15px;
  }

  @media screen and (max-width: 749px) {
    .category-circle-arrow {
      opacity: 0.95;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(-50%) scale(0.9);
    }
    .category-circle-arrow-prev {
      left: 0px;
    }
    .category-circle-arrow-next {
      right: 0px;
    }
  }

  .category-circle-arrow svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: #333;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
{%- endstyle -%}

<div class="category-circles-wrapper section-{{ section.id }}-padding" {% if section.settings.hide_section %}style="display: none !important;"{% endif %}>
  <div class="category-circles-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="category-circles-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="category-circles-scroll-wrapper">
      {%- if section.settings.show_arrows -%}
        <button type="button" class="category-circle-arrow category-circle-arrow-prev" aria-label="Scroll left">
          <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
      {%- endif -%}

      <div class="category-circles-grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign collection_obj = collections[block.settings.collection]
            assign vendor_name = block.settings.vendor | strip
            assign category_name = block.settings.category | strip
            assign tag_name = block.settings.tag | strip
            
            # URL logic: 1) Custom link, 2) Collection URL, 3) Vendor URL, 4) Category URL, 5) Tag URL
            assign item_url = block.settings.link
            if item_url == blank and collection_obj != blank
              assign item_url = collection_obj.url
            elsif item_url == blank and vendor_name != blank
              assign vendor_url_param = vendor_name | url_encode
              assign item_url = "/collections/all?filter.p.vendor=" | append: vendor_url_param
            elsif item_url == blank and category_name != blank
              assign category_url_param = category_name | url_encode
              assign item_url = "/collections/all?filter.p.product_type=" | append: category_url_param
            elsif item_url == blank and tag_name != blank
              assign tag_handle = tag_name | handleize
              assign item_url = "/collections/all/" | append: tag_handle
            endif
            if item_url == blank
              assign item_url = "#"
            endif

            # Title logic: 1) Custom title, 2) Collection title, 3) Vendor name, 4) Category name, 5) Tag name
            assign item_title = block.settings.title
            if item_title == blank and collection_obj != blank
              assign item_title = collection_obj.title
            elsif item_title == blank and vendor_name != blank
              assign item_title = vendor_name
            elsif item_title == blank and category_name != blank
              assign item_title = category_name
            elsif item_title == blank and tag_name != blank
              assign item_title = tag_name
            endif
            if item_title == blank
              assign item_title = "Category"
            endif

            # Image logic: 1) Custom image, 2) Collection featured image / first product image
            assign item_image = block.settings.image
            if item_image == blank and collection_obj != blank
              if collection_obj.featured_image != blank
                assign item_image = collection_obj.featured_image
              elsif collection_obj.products.first != blank and collection_obj.products.first.featured_image != blank
                assign item_image = collection_obj.products.first.featured_image
              endif
            endif
          -%}

          <a href="{{ item_url }}" class="category-circle-item" {{ block.shopify_attributes }}>
            <div class="category-circle-image-wrapper">
              {%- if item_image != blank -%}
                <img
                  src="{{ item_image | image_url: width: 400 }}"
                  alt="{{ item_title | escape }}"
                  loading="lazy"
                  width="200"
                  height="200"
                  class="category-circle-image"
                >
              {%- else -%}
                <div class="category-circle-placeholder">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {%- endif -%}
            </div>
            <span class="category-circle-title">{{ item_title }}</span>
          </a>
        {%- endfor -%}
      </div>

      {%- if section.settings.show_arrows -%}
        <button type="button" class="category-circle-arrow category-circle-arrow-next" aria-label="Scroll right">
          <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function() {
    function initCategoryCircleScroll() {
      const section = document.getElementById('shopify-section-{{ section.id }}');
      if (!section) return;
      const grid = section.querySelector('.category-circles-grid');
      const prevBtn = section.querySelector('.category-circle-arrow-prev');
      const nextBtn = section.querySelector('.category-circle-arrow-next');

      if (grid && prevBtn && nextBtn) {
        prevBtn.addEventListener('click', function() {
          grid.scrollBy({ left: -360, behavior: 'smooth' });
        });
        nextBtn.addEventListener('click', function() {
          grid.scrollBy({ left: 360, behavior: 'smooth' });
        });
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCategoryCircleScroll);
    } else {
      initCategoryCircleScroll();
    }
  })();
</script>

{% schema %}
{
  "name": "Category Circles",
  "tag": "section",
  "class": "section-category-circles",
  "settings": [
    {
      "type": "checkbox",
      "id": "hide_section",
      "label": "Hide section on storefront",
      "default": false,
      "info": "When checked, this section will be hidden on the storefront."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
      "step": 10,
      "unit": "px",
      "label": "Section Container Max Width",
      "default": 1430
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Scroll Navigation Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_scrollbar",
      "label": "Hide Horizontal Scrollbar",
      "default": true
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 28
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#232323"
    },
    {
      "type": "range",
      "id": "circle_size",
      "min": 80,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Circle Size",
      "default": 170
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Label Font Size",
      "default": 15
    },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "Label Font Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Label Color",
      "default": "#232323"
    },
    {
      "type": "color",
      "id": "title_hover_color",
      "label": "Label Hover Color",
      "default": "#8b0000"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "collection_circle",
      "name": "Circle Item",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category / Product Type",
          "info": "Enter category/product type (e.g. Kurtas, Bags, Necklaces, Rings, etc.)"
        },
        {
          "type": "text",
          "id": "vendor",
          "label": "Vendor / Brand Name",
          "info": "Enter vendor/brand name (e.g. Gucci, Chanel, Rolex, etc.)"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Product Tag",
          "info": "Enter tag name (e.g. Festive, Pooja, Sangeet)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image",
          "info": "Option to put a custom image for the item"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Label",
          "info": "Overrides collection, category, or vendor name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link",
          "info": "Overrides automatic collection, category, or vendor filter URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Circles",
      "blocks": [
        {
          "type": "collection_circle",
          "settings": {
            "title": "Pooja"
          }
        },
        {
          "type": "collection_circle",
