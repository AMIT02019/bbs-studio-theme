      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 1200,
      "max": 1920,
      "step": 40,
      "unit": "px",
      "default": 1600
