{% doc %}
  @prompt
    % comment %}
      SECTION: Collection Categories Grid
      Features:
      - 3 category blocks
      - Select collection from Theme Editor
      - Optional custom image override per collection
      - Optional custom page link override per collection
      - Fully responsive
      - Hover effect
      - Entire card clickable
    {% endcomment %}
    
    <section class="collection-categories-section">
      <div class="collection-categories-wrapper">
    
        {% for block in section.blocks %}
          {% assign collection = collections[block.settings.collection] %}
    
          <a
            href="{{ collection.url }}"
            class="collection-category-card"
            {{ block.shopify_attributes }}
          >
    
            <div class="collection-category-image-wrapper">
    
              {% if block.settings.custom_image != blank %}
                <img
                  src="{{ block.settings.custom_image | image_url: width: 800 }}"
                  alt="{{ collection.title }}"
                  loading="lazy"
                  class="collection-category-image"
                >
              {% elsif collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 800 }}"
                  alt="{{ collection.title }}"
                  loading="lazy"
                  class="collection-category-image"
                >
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
    
            </div>
    
            <div class="collection-category-content">
              <h3 class="collection-category-title">
                {{ collection.title }}
              </h3>
            </div>
    
          </a>
        {% endfor %}
    
      </div>
    </section>
    
    <style>
    .collection-categories-section {
      padding: 60px 20px;
    }
    
    .collection-categories-wrapper {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 20px;
      max-width: 1600px;
      margin: 0 auto;
    }
    
    .collection-category-card {
      display: block;
      text-decoration: none;
      color: inherit;
      background: #fff;
      border-radius: 14px;
      overflow: hidden;
      transition: all 0.35s ease;
      position: relative;
    }
    
    .collection-category-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 30px rgba(0,0,0,0.12);
    }
    
    .collection-category-image-wrapper {
      position: relative;
      width: 100%;
      padding-top: 100%;
      overflow: hidden;
      background: #f5f5f5;
    }
    
    .collection-category-image,
    .collection-category-image-wrapper img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    
    .collection-category-content {
      padding: 16px;
      text-align: center;
    }
    
    .collection-category-title {
      margin: 0;
      font-size: 18px;
      font-weight: 600;
      line-height: 1.3;
    }
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-collection-grid-section-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
  }

  .ai-collection-grid-wrapper-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.gap }}px;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-collection-card-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    transition: all 0.35s ease;
    position: relative;
  }

  .ai-collection-card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 {{ block.settings.hover_shadow_y }}px {{ block.settings.hover_shadow_blur }}px rgba(0,0,0,{{ block.settings.hover_shadow_opacity }});
  }

  .ai-collection-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-top: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background: {{ block.settings.placeholder_background }};
  }

  .ai-collection-image-{{ ai_gen_id }},
  .ai-collection-image-wrapper-{{ ai_gen_id }} img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-image-wrapper-{{ ai_gen_id }} svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-collection-title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: {{ block.settings.title_font_weight }};
    line-height: 1.3;
    color: {{ block.settings.title_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-collection-grid-wrapper-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.gap_mobile }}px;
    }

    .ai-collection-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.9 }}px;
    }

    .ai-collection-grid-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }
  }
{% endstyle %}

<ai-collection-grid-{{ ai_gen_id }} class="ai-collection-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <section class="ai-collection-grid-section-{{ ai_gen_id }}">
    <div class="ai-collection-grid-wrapper-{{ ai_gen_id }}">
      {% liquid
        assign collection_1 = block.settings.collection_1
        assign collection_2 = block.settings.collection_2
        assign collection_3 = block.settings.collection_3
        assign collections_array = ''
        
        if collection_1
          assign collections_array = collections_array | append: '1,'
        endif
        if collection_2
          assign collections_array = collections_array | append: '2,'
        endif
        if collection_3
          assign collections_array = collections_array | append: '3,'
        endif
      %}

      {% for i in (1..3) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign custom_image_key = 'custom_image_' | append: i
          assign custom_title_key = 'custom_title_' | append: i
          assign custom_link_key = 'custom_link_' | append: i
          
          assign collection = block.settings[collection_key]
          assign custom_image = block.settings[custom_image_key]
          assign custom_title = block.settings[custom_title_key]
          assign custom_link = block.settings[custom_link_key]
          
          if custom_link != blank
            assign card_url = custom_link
          elsif collection
            assign card_url = collection.url
          else
            assign card_url = '#'
          endif
        %}

        <a
          href="{{ card_url }}"
          class="ai-collection-card-{{ ai_gen_id }}"
        >
          <div class="ai-collection-image-wrapper-{{ ai_gen_id }}">
            {% if custom_image != blank %}
              <img
                src="{{ custom_image | image_url: width: 800 }}"
                alt="{{ custom_image.alt | default: collection.title | escape }}"
                loading="lazy"
                class="ai-collection-image-{{ ai_gen_id }}"
                width="800"
                height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
              >
            {% elsif collection and collection.featured_image %}
              <img
                src="{{ collection.featured_image | image_url: width: 800 }}"
                alt="{{ collection.featured_image.alt | default: collection.title | escape }}"
                loading="lazy"
                class="ai-collection-image-{{ ai_gen_id }}"
                width="800"
                height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
              >
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag }}
            {% endif %}
          </div>

          <div class="ai-collection-content-{{ ai_gen_id }}">
            <h3 class="ai-collection-title-{{ ai_gen_id }}">
              {% if custom_title != blank %}
                {{ custom_title }}
              {% elsif collection %}
                {{ collection.title }}
              {% else %}
                Collection {{ i }}
              {% endif %}
            </h3>
          </div>
        </a>
      {% endfor %}
    </div>
  </section>
</ai-collection-grid-{{ ai_gen_id }}>

{% schema %}
{
